{
  "name": "waveform-soundboard",
  "version": "0.3.0",
  "private": true,
  "description": "A desktop soundboard with microphone mixing and global shortcuts",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test test/*.test.cjs",
    "package:win": "npm run build && electron-builder --win zip --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "test:ui": "playwright test",
    "package:installer": "npm run build && electron-builder --win nsis --publish never",
    "format": "prettier --write src desktop test *.json *.js *.cjs *.html README.md",
    "test:desktop": "npm run build && node test/desktop-smoke.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "studio.waveform.soundboard",
    "productName": "Waveform",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "assets/icon.png",
      "shared/**/*",
      "assets/icon.ico"
    ],
    "win": {
      "target": "zip",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Waveform"
    },
    "mac": {
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Waveform mixes your microphone with sound effects for your selected virtual audio output."
      }
    },
    "linux": {
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "third-party-sources",
        "to": "third-party-sources"
      }
    ]
  },
  "author": "Waveform contributors",
  "dependencies": {
    "mpg123-decoder": "^1.0.3"
  }
}
